# Optional read-only override. The public endpoint is used when omitted.
PHASE6_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Required by `pnpm phase6:account` and `pnpm phase6:execute`. Never commit the
# real value.
# Fund its address with at least the dynamic amount printed by the runner; the
# current minimum gate is 0.25 Sepolia ETH. Never paste this key into chat.
PHASE6_DEPLOYER_PRIVATE_KEY=0x
