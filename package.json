{
  "name": "nox-confidential-governance-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm build:forge && pnpm build:hardhat",
    "build:forge": "forge build --skip test",
    "build:hardhat": "hardhat compile",
    "lint:forge": "forge lint src/contracts --severity high med --out out/lint-src --cache-path cache/lint-src && forge lint test/foundry --skip ConfidentialBallotCasting.t.sol --skip ConfidentialBallotTally.t.sol --skip ConfidentialBallotProofNegativeMatrix.t.sol --skip TallyFixtures.sol --skip ConfidentialGovernorLifecycle.t.sol --skip ConfidentialGovernorTimelock.t.sol --skip GovernorFixtures.sol --skip SafeConfidentialVotingModuleExecution.t.sol --skip SafeConfidentialVotingModuleBatchExecution.t.sol --skip SafeExecutionFixtures.sol --skip SafeBatchExecutionFixtures.sol --skip ConfidentialGovernanceInvariants.t.sol --skip ConfidentialGovernanceGas.t.sol --severity high med --out out/lint-test --cache-path cache/lint-test",
    "test": "pnpm test:forge && pnpm test:integration",
    "test:forge": "forge test -vvv",
    "test:invariant": "FOUNDRY_PROFILE=invariant forge test --match-contract ConfidentialGovernanceInvariantTest --summary -vv",
    "test:integration": "pnpm build:forge && hardhat test nodejs",
    "phase6:preflight": "pnpm build && node --env-file-if-exists=.env scripts/phase6-sepolia.ts",
    "phase6:account": "pnpm build && node --env-file-if-exists=.env scripts/phase6-sepolia.ts --account",
    "phase6:execute": "pnpm build && node --env-file-if-exists=.env scripts/phase6-sepolia.ts --execute",
    "apps:build": "pnpm -r --filter \"./apps/*\" build",
    "apps:dev": "pnpm --filter @noxvote/landing dev",
    "format": "forge fmt && prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "forge fmt --check && prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "clean": "forge clean && hardhat clean"
  },
  "dependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/safe-smart-account": "1.5.0",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@iexec-nox/nox-hardhat-plugin": "0.2.0",
    "@nomicfoundation/hardhat-foundry": "3.0.4",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.17",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@tsconfig/node24": "24.0.1",
    "@types/node": "^24.0.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.1",
    "hardhat": "3.11.1",
    "prettier": "3.8.3",
    "typescript": "5.8.3",
    "viem": "2.55.10"
  }
}
